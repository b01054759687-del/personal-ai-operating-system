{
  "adapter": "claude",
  "version": "1.1.0",
  "direction": "SOURCE_TO_TARGET",
  "mcp_access_mode": "READ_ONLY",
  "mappings": [
    {
      "asset_type": "skills",
      "source_pattern": "02-AI-ASSETS/skills/{name}/SKILL.md",
      "target_pattern": ".claude/skills/{name}.md",
      "transform": "CLAUDE_SKILL_PROJECTION",
      "target_entrypoint": "{name}.md",
      "notes": "Transforms canonical skills into Claude skill markdown files or tool definitions."
    },
    {
      "asset_type": "agents",
      "source_pattern": "02-AI-ASSETS/agents/{category}/{name}/AGENT.md",
      "target_pattern": ".claude/agents/{name}.md",
      "transform": "CLAUDE_AGENT_PERSONA_PROJECTION",
      "target_entrypoint": "{name}.md",
      "notes": "Exports agent role and mission into Claude subagent system prompt format."
    },
    {
      "asset_type": "rules",
      "source_pattern": "02-AI-ASSETS/rules/{name}.md",
      "target_pattern": ".claude/rules/{name}.md",
      "transform": "CLAUDE_RULE_PROJECTION",
      "target_entrypoint": "{name}.md",
      "notes": "Maps canonical operational rules to Claude rules and consolidates into CLAUDE.md."
    },
    {
      "asset_type": "prompts",
      "source_pattern": "05-PROMPT-LIBRARY/system-workflows/{name}.md",
      "target_pattern": ".claude/commands/{name}.md",
      "transform": "CLAUDE_CUSTOM_COMMAND",
      "target_entrypoint": "{name}.md",
      "notes": "Projects workflow prompt files to Claude Code / Desktop custom slash commands."
    },
    {
      "asset_type": "knowledge",
      "source_pattern": "07-KNOWLEDGE/{category}/{name}.md",
      "target_pattern": ".claude/knowledge/{category}/{name}.md",
      "transform": "CLAUDE_STRUCTURED_MEMORY_MIRROR",
      "target_entrypoint": "{name}.md",
      "notes": "Mirrors structured knowledge for Claude context retrieval and subagent consultation."
    },
    {
      "asset_type": "registries",
      "source_pattern": "04-REGISTRY/{name}.json",
      "target_pattern": ".claude/registries/{name}.json",
      "transform": "READ_ONLY_REGISTRY_MIRROR",
      "target_entrypoint": "{name}.json",
      "notes": "Exposes machine-readable registries for Claude to inspect system inventory and status."
    }
  ]
}
