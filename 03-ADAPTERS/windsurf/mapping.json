{
  "adapter": "windsurf",
  "version": "1.0.0",
  "direction": "SOURCE_TO_TARGET",
  "mappings": [
    {
      "asset_type": "rules",
      "source_pattern": "02-AI-ASSETS/rules/{name}.md",
      "target_pattern": ".windsurfrules",
      "transform": "WINDSURF_RULES_CONCATENATION",
      "target_entrypoint": ".windsurfrules",
      "notes": "Concatenates global rules and behavioral guidelines into Windsurf's .windsurfrules file."
    },
    {
      "asset_type": "workflows",
      "source_pattern": "05-PROMPT-LIBRARY/system-workflows/{name}.md",
      "target_pattern": ".windsurf/workflows/{name}.md",
      "transform": "CASCADE_WORKFLOW_PROJECTION",
      "target_entrypoint": "{name}.md",
      "notes": "Projects PAI-OS system workflows into Windsurf Cascade workflows."
    },
    {
      "asset_type": "ai_assets",
      "source_pattern": "02-AI-ASSETS/skills/{name}/SKILL.md",
      "target_pattern": ".windsurf/skills/{name}.md",
      "transform": "SKILL_CONTEXT_MIRROR",
      "target_entrypoint": "{name}.md",
      "notes": "Projects canonical skills as contextual guides for Windsurf Cascade."
    }
  ]
}
