{
  "adapter_name": "windsurf",
  "display_name": "Codeium Windsurf IDE Adapter",
  "version": "1.0.0",
  "status": "active",
  "sync_architecture": "OPTION_A_ONE_WAY_ONLY",
  "sync_direction": "SOURCE_TO_TARGET",
  "source_of_truth": {
    "repository": "personal-ai-operating-system",
    "base_path": "02-AI-ASSETS/",
    "rules_path": "02-AI-ASSETS/rules/",
    "prompt_library": "05-PROMPT-LIBRARY/system-workflows/"
  },
  "target_environment": {
    "tool": "Windsurf IDE",
    "project_rules_file": ".windsurfrules",
    "project_workflows_dir": ".windsurf/workflows/"
  },
  "supported_asset_types": [
    "rules",
    "workflows",
    "ai_assets"
  ],
  "policies": {
    "allow_two_way_sync": false,
    "allow_automatic_imports": false,
    "conflict_resolution": "OVERWRITE_TARGET_FROM_SOURCE_OF_TRUTH",
    "backup_before_sync": true
  }
}
